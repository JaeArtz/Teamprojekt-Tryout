  m_Script: {fileID: 11500000, guid: 6640d0b7014bcf743ac082c8476883b3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UI_SpeechBubbleManager
  messageText: {fileID: 706268463}
  talkingAudioSource: {fileID: 0}
  interactionVisual: {fileID: 1055462323}
  speechBubbleContainer: {fileID: 198491782}
  playerTransform: {fileID: 1876935962}
  activationRadius: 5
  exitRadiusCooldown: 2
  cooldownTime: 3
  typingSpeed: 0.02
  messageArray:
  - Our world has died. We saw no hope for new Life.
  - Maybe you can change that.
  - Some <color=#00E2FB>Souls</color> have not succumbed to Despair just yet.
  - A few <color=#00E2FB>Animals</color> want to help you. Touch their <color=#00E2FB>Souls</color>,
  - and they will share their Power with you.
  - Thanks to the Power of the <color=#00E2FB>Rabbit</color>, you can now <color=#00E2FB>jump
    twice</color>!
  - <color=yellow>Collect </color><color=#00E2FB>Animal Souls</color><color=yellow>
    in the World</color>
  - '<color=yellow>when you see them.</color> '
  - <color=yellow>Each </color><color=#00E2FB>Animal Soul</color> <color=yellow>will
    grant you a new </color><color=#00E2FB>Skill</color><color=yellow>.</color>
  - <color=yellow>The </color><color=#00E2FB>Rabbit Soul</color><color=yellow> unlocks
    </color><color=#00E2FB>Double Jump</color><color=yellow>.</color>
