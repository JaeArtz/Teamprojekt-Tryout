  m_Script: {fileID: 11500000, guid: 6640d0b7014bcf743ac082c8476883b3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UI_SpeechBubbleManager
  messageText: {fileID: 2037630458}
  talkingAudioSource: {fileID: 0}
  interactionVisual: {fileID: 1476223247}
  speechBubbleContainer: {fileID: 2075481058}
  playerTransform: {fileID: 1876935962}
  activationRadius: 5
  exitRadiusCooldown: 2
  cooldownTime: 3
  typingSpeed: 0.02
  messageArray:
  - I am sorry. I can't tell you who or what you are.
  - You embark on a <color=#00E2FB>Great Journey</color>...
  - To find yourself... And your purpose.
  - Let my children guide you on your <color=#00E2FB>Quest</color>.
  - They will light your path, and show you
  - where you can travel safely.
  - And sometimes, they might show you
  - the way to <color=#00E2FB>hidden treasures</color> of the World!
  - <color=yellow>When you see a swarm of  </color><color=#00E2FB>Fireflies</color>
  - <color=yellow>you can walk in, or jump down the way they show you. </color>
  - <color=#00E2FB>Fireflies</color><color=yellow> mark either a safe passageway,
    </color>
  - <color=yellow>or hint at a <color=#00E2FB>hidden treasure</color><color=yellow>.</color>
