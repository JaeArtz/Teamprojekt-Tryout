    - target: {fileID: 4621998646688656210, guid: 25562f04acd008843b8ce7a876cbafb7, type: 3}
      propertyPath: m_Camera
      value: 
      objectReference: {fileID: 519420031}
    - target: {fileID: 7786807045612242666, guid: 25562f04acd008843b8ce7a876cbafb7, type: 3}
